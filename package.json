{
  "name": "dizzle-local-workflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test && playwright test -c playwright.signin.config.ts",
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "social:worker": "tsx scripts/social-worker.ts",
    "social:media": "tsx scripts/social-media.ts",
    "social:connect": "tsx scripts/social-connect.ts",
    "social:reconcile": "tsx scripts/social-reconcile.ts",
    "social:staging:check": "tsx scripts/social-staging-preflight.ts",
    "social:pilot:verify": "vitest run tests/social-pilot.test.ts tests/publishing-controls.test.ts",
    "social:pilot:select": "tsx scripts/social-pilot-select.ts",
    "pretypecheck": "tsx scripts/prepare-marketing-consumer.ts",
    "pretest": "tsx scripts/prepare-marketing-consumer.ts",
    "prebuild": "tsx scripts/prepare-marketing-consumer.ts",
    "auth:serve": "tsx server/identity-index.ts",
    "auth:operator": "tsx scripts/identity-operator.ts",
    "marketing:serve": "tsx server/marketing-index.ts",
    "demo:signin": "tsx scripts/signin-demo.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "google-auth-library": "11.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
