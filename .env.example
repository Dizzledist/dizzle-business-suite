# Opt in only after rotating the exposed Zoho client secret.
SALES_CRM_ENABLED=false
ZOHO_ENABLED=false
ZOHO_ORGANIZATION_ID=821729823
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3001/api/integrations/zoho/callback
# Set the matching official Accounts and Inventory v1 URLs for your data center.
ZOHO_ACCOUNTS_URL=
ZOHO_API_BASE_URL=
# Independent 32-byte random keys encoded as 64 hexadecimal characters.
ZOHO_LOCAL_ADMIN_KEY=
ZOHO_TOKEN_ENCRYPTION_KEY=
# Absolute path in an existing private directory outside the checkout.
ZOHO_TOKEN_STORE_PATH=

# Business calendar for the synthetic Sales CRM reporting preview.
SALES_REPORTING_TIME_ZONE=America/Los_Angeles
INITIAL_SALES_RECOGNITION_DATE=2026-10-01
# Opt-in synthetic administrator evidence and dual reporting modes. No live activation.
SALES_HISTORICAL_EVIDENCE_ENABLED=false
# Set only after approving the real internal tenant and a mapping review reference.
SALES_ZOHO_TENANT_ID=
SALES_ZOHO_APPROVAL_REFERENCE=

# Require server-side sessions for the loopback Sales CRM. Company login requires a separately approved provider.
SALES_CRM_AUTH_ENABLED=false

# Local company email and password login
SALES_CRM_PASSWORD_ENABLED=false
DIZZLE_WEB_PORT=5173
DIZZLE_API_PORT=3001
