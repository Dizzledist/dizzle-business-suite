# Copy to .env and enter your key there. Never put the key in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_IMAGE_QUALITY=medium

# Optional caption drafting; choose a text model accessible to your project. No default paid calls.
OPENAI_CAPTION_MODEL=
# Social setup: private server-only values. Live publishing stays hard-disabled in this PR.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=
X_CLIENT_ID=
X_CLIENT_SECRET=
SOCIAL_OAUTH_REDIRECT_URI=
SOCIAL_TOKEN_KEY=
SOCIAL_MEDIA_ORIGIN=
SOCIAL_MEDIA_SIGNING_KEY=
# Optional absolute private path OUTSIDE the checkout; API/worker/media must use the same directory.
DIZZLE_PUBLISHING_DIR=

# Stable marketing history path for staging releases; defaults remain unchanged when omitted.
DIZZLE_MARKETING_DIR=
# Optional exact OAuth handle check before saving any account credentials.
SOCIAL_EXPECTED_HANDLE=
