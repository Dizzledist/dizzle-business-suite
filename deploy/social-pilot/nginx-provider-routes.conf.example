# Include ONLY inside an operator-configured HTTPS virtual host with real DNS/TLS.
# No /api, app root, static SPA or fixture identity route may be exposed here.
# X does not need the media route. Callback route only exists during a connect command.
location = /oauth/callback {
    limit_except GET { deny all; }
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://127.0.0.1:3499;
    proxy_set_header Host 127.0.0.1:3499;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
}

# Instagram only. Keep query-string capabilities out of access/error logs.
location ~ ^/social-media/[a-f0-9-]+\.jpg$ {
    limit_except GET { deny all; }
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://127.0.0.1:3498;
    proxy_set_header Host 127.0.0.1:3498;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    add_header Referrer-Policy no-referrer always;
}

location / { return 404; }
