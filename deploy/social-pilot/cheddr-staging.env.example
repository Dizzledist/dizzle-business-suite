# Private operator-managed file: /etc/dizzle/cheddr-staging.env (mode 0600).
# Never put this file or actual values in the checkout. No live publishing toggle exists.
NODE_ENV=development
DIZZLE_PILOT_PRIVATE_ONLY=1
DIZZLE_MARKETING_DIR=/var/lib/dizzle/cheddr-staging
DIZZLE_PUBLISHING_DIR=/var/lib/dizzle/cheddr-staging
DIZZLE_WEB_PORT=5173
DIZZLE_API_PORT=3001

# First account: @cheddrco_. X developer app setup is still required.
SOCIAL_EXPECTED_HANDLE=@cheddrco_
X_CLIENT_ID=
X_CLIENT_SECRET=
SOCIAL_TOKEN_KEY=
# Exact registered URL, including scheme/host/port/path and trailing-slash choice.
# X loopback candidate: http://127.0.0.1:3499/oauth/callback (verify console accepts it).
# Hosted HTTPS alternative: https://<your-owned-host>/oauth/callback
SOCIAL_OAUTH_REDIRECT_URI=
SOCIAL_OAUTH_PORT=3499

# Instagram alternative only; leave unused for the first X pilot.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=
SOCIAL_MEDIA_ORIGIN=
SOCIAL_MEDIA_SIGNING_KEY=
SOCIAL_MEDIA_PORT=3498

# Deliberately omit OpenAI credentials/models from test staging.
# Publishing verification injects test image/caption adapters; no paid calls are needed.
